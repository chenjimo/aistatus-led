{
  "name": "dsh",
  "label": "DeepSeek Harness (DSH)",
  "detect": {
    "tools": ["bash", "pwsh", "read_file", "write_file"]
  },
  "events": {
    "aistatus/plugin-loaded": "session_start",
    "session/created": "session_start",
    "session/close": "session_end",
    "session/disposed": "session_end",
    "session/agent-busy": "noop",
    "session/event": "noop",
    "session/prompt": "prompt",
    "user/message": "prompt",
    "turn/start": "busy",
    "turn/end": "done",
    "agent/created": "noop",
    "agent/request": "busy",
    "agent/pre-step": "busy",
    "agent/assistant-stream": "outputting",
    "agent/turn-stopping": "done",
    "agent/error": "failure_event",
    "agent/request-error": "failure_event",
    "tools/pre-execute": "pre_tool",
    "tools/call": "pre_tool",
    "tool/call": "pre_tool",
    "tools/execute": "pre_tool",
    "tools/post-execute": "post_tool_keep",
    "tools/result": "post_tool_keep",
    "tool/result": "post_tool_keep",
    "approval/request": "need_confirm",
    "approval/asked": "need_confirm",
    "approval/decided": "approval_decided",
    "notifications/elicitation": "need_input",
    "question/request": "need_input",
    "ask/user": "need_input",
    "assistant/message": "outputting",
    "assistant/chunk": "outputting",
    "assistant/live-chunk": "outputting",
    "assistant/attempt": "busy"
  },
  "search_tools": ["read_file", "Read", "grep", "rg", "glob", "Glob", "list_dir", "web_search", "web_fetch", "search"],
  "code_tools": ["bash", "Bash", "pwsh", "write_file", "edit_file", "apply_patch", "shell", "write", "edit"],
  "input_tools": ["ask_user", "question", "askUser"],
  "failure_prefixes": ["error calling tool", "tool execution failed", "command failed", "permission denied", "exit code", "exited with", "non-zero exit"],
  "notification": {
    "permission_prompt": "need_confirm",
    "approval_request": "need_confirm",
    "idle_prompt": "need_input",
    "question": "need_input"
  },
  "command_search_patterns": ["grep", "rg ", "find ", "cat ", "ls ", "head ", "tail ", "sed ", "awk "]
}
